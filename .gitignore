# Market data - multi-GB, never commit.
# Ignore everything in data/ by extension-agnostic rule: real ITCH files are
# named like 12302019.NASDAQ_ITCH50, with no extension to match on.
data/*
!data/README.md

# Benchmark output - numbers live in README.md and DESIGN.md, raw files go stale
*.hgrm
jmh-result.*
jmh-*.text
results/

